{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/sw.mjs",
  "installCommand": "",
  "outputDirectory": "app",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), fullscreen=(self), screen-wake-lock=(self)" }] }
  ]
}
